{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx playwright:*)",
      "Bash(npx esbuild:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(clasp:*)",
      "Bash(npx clasp:*)",
      "Bash(npx @google/clasp:*)"
    ]
  }
}
